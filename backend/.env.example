# --- App ---
APP_NAME=Willook CRM API
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# Local/dev: SQLite. Swap to Postgres in staging/prod, e.g.:
# DATABASE_URL=postgresql+asyncpg://willook:change_me@postgres:5432/willook_crm
DATABASE_URL=sqlite+aiosqlite:///./willook_crm.db
DB_ECHO=false

# --- JWT / Auth ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_IN_PROD
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Account lockout ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Rate limiting (Redis-backed sliding window) ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_ENABLED=true

# --- CORS ---
# JSON array of allowed origins for the Vue frontend
CORS_ORIGINS=["http://localhost:5173"]

# --- Pagination ---
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
